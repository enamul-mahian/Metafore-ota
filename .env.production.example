# Secret-free production deployment reference.
# Supply every blank required value through the deployment platform's secret
# store. Never deploy this file as the real .env without completing it.

APP_NAME="Eagle Global Hub LTD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# A durable production database is required. Create it and its restricted
# application user outside Laravel before deployment.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Database-backed stores use the cache, sessions, jobs, job_batches and
# failed_jobs tables provided by repository migrations.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database
DB_QUEUE=default

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Configure a real delivery transport. SMTP is shown without credentials.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Flight search remains unavailable until an approved provider is configured.
FLIGHT_SEARCH_PROVIDER=unavailable

DUFFEL_ACCESS_TOKEN=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_CONNECT_TIMEOUT=5
DUFFEL_HTTP_TIMEOUT=30
DUFFEL_SUPPLIER_TIMEOUT_MS=20000
DUFFEL_STAYS_SEARCH_RADIUS_KM=5
DUFFEL_PAYMENT_TYPE=

# Independent live-order safety gates. Keep both false until separately
# approved after provider, payment, operational and rollback review.
DUFFEL_LIVE_ORDER_CREATION_ENABLED=false
FLIGHT_ORDER_HTTP_EXECUTION_ENABLED=false

# Optional providers are safe when disabled and do not require credentials.
HOTELS_ENABLED=false
HOTEL_PROVIDER=unavailable
HOTEL_API_KEY=

TOURS_ENABLED=false
TOUR_PROVIDER=unavailable
TOUR_API_KEY=
VIATOR_API_BASE_URL=https://api.viator.com/partner
VIATOR_API_VERSION=2.0
VIATOR_LOCALE=en-US
VIATOR_CURRENCY=USD
VIATOR_CONNECT_TIMEOUT=5
VIATOR_HTTP_TIMEOUT=20
VIATOR_SEARCH_COUNT=20

VISA_ENABLED=false
VISA_PROVIDER=unavailable
VISA_API_KEY=
SHERPA_API_BASE_URL=
SHERPA_LOCALE=en-US
SHERPA_CURRENCY=USD
SHERPA_CONNECT_TIMEOUT=5
SHERPA_HTTP_TIMEOUT=20
